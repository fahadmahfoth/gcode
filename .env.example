# gcode — example environment file
#
# Copy to `.env` and fill in locally. `.env` is gitignored and must never be
# committed.
#
#     cp .env.example .env
#
# This file intentionally contains NO real values. Every secret is either empty
# or an obvious placeholder. The CI secret scanner fails the build if this file
# ever gains a credential-shaped string with a plausible value.
#
# ──────────────────────────────────────────────────────────────────────────
# gcode itself requires NONE of these. It is local-first and has no API keys.
# See docs/adr/0001-local-first-offline-inference.md.
#
# These variables exist for BUILD, RELEASE, and PACKAGING only.
# ──────────────────────────────────────────────────────────────────────────

# ── Release signing (CI only) ────────────────────────────────────────────
# Releases use keyless Sigstore OIDC: no private key is needed or wanted.
# See docs/adr/0016-keyless-signing.md.
# SIGSTORE_PRIVATE_KEY=
# SIGSTORE_PRIVATE_KEY_PASSWORD=
# SIGSTORE_IDENTITY=
# SIGSTORE_OIDC_ISSUER=

# ── GitHub API (CI only) ──────────────────────────────────────────────────
# Use a fine-grained token with contents:read and packages:write only.
# Supply it as a CI secret, never in this file.
# GITHUB_TOKEN=
# GHCR_TOKEN=
# GITHUB_REPOSITORY=

# ── Package publishing ───────────────────────────────────────────────────
# Homebrew, AUR, APT, and COPR all need credentials.
# Every one of these is a maintainer account and is marked 🔒 in
# docs/ROADMAP.md. They are NEVER committed.
# HOMEBREW_TAP_TOKEN=
# AUR_SSH_KEY=
# APT_GPG_PASSPHRASE=
# COPR_API_TOKEN=

# ── Model mirrors (optional) ─────────────────────────────────────────────
# A local or corporate mirror. The model checksum is pinned in
# models/registry.toml, so a mirror cannot substitute content.
# GCODE_MODEL_MIRROR=

# ── Runtime overrides (optional) ──────────────────────────────────────────
# GCODE_MODEL=/path/to/model.gguf
# GCODE_CONFIG=/path/to/config.toml
# GCODE_LOG_LEVEL=debug
# GCODE_HISTORY_FILE=/path/to/history.jsonl
# GCODE_NO_HISTORY=
# GCODE_NO_INIT=
# GCODE_NO_MODEL=
# GCODE_INSTALL_DIR=$HOME/.local/bin

# ── Test-only values ─────────────────────────────────────────────────────
# Used by integration tests with a fake inference engine. Never real
# credentials, even expired ones.
GCODE_TEST_FIXTURE=placeholder
